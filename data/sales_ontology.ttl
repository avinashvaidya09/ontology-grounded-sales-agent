@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sales: <http://example.org/sales/> .

# ─────────────────────────────────────────────
# ONTOLOGY — class and property definitions
# (equivalent to CREATE TABLE / schema layer)
# ─────────────────────────────────────────────

sales:Customer       rdf:type rdfs:Class ;
                     rdfs:label "Customer" .

sales:SalesOrder     rdf:type rdfs:Class ;
                     rdfs:label "Sales Order" .

sales:SalesOrderItem rdf:type rdfs:Class ;
                     rdfs:label "Sales Order Item" .

sales:Delivery       rdf:type rdfs:Class ;
                     rdfs:label "Delivery" .

sales:Material       rdf:type rdfs:Class ;
                     rdfs:label "Material" .

sales:Supplier       rdf:type rdfs:Class ;
                     rdfs:label "Supplier" .

# Object properties — link one resource to another resource

sales:places         rdf:type    rdf:Property ;
                     rdfs:domain sales:Customer ;
                     rdfs:range  sales:SalesOrder .

sales:contains       rdf:type    rdf:Property ;
                     rdfs:domain sales:SalesOrder ;
                     rdfs:range  sales:SalesOrderItem .

sales:fulfilledBy    rdf:type    rdf:Property ;
                     rdfs:domain sales:SalesOrder ;
                     rdfs:range  sales:Delivery .

sales:fulfills       rdf:type    rdf:Property ;
                     rdfs:domain sales:Delivery ;
                     rdfs:range  sales:SalesOrderItem .

sales:references     rdf:type    rdf:Property ;
                     rdfs:domain sales:SalesOrderItem ;
                     rdfs:range  sales:Material .

sales:suppliedBy     rdf:type    rdf:Property ;
                     rdfs:domain sales:Material ;
                     rdfs:range  sales:Supplier .

# Datatype properties — link a resource to a plain value (Literal)

sales:status             rdf:type    rdf:Property ;
                         rdfs:domain sales:SalesOrder .

sales:availabilityStatus rdf:type    rdf:Property ;
                         rdfs:domain sales:Material .

# ─────────────────────────────────────────────
# INSTANCE DATA — specific business records
# (equivalent to INSERT INTO rows)
# ─────────────────────────────────────────────

sales:ACME          rdf:type         sales:Customer ;
                    rdfs:label       "ACME Corp" .

sales:SO100         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 100" ;
                    sales:status     "DELAYED" .

sales:SO100_ITEM10  rdf:type         sales:SalesOrderItem .

sales:DEL800        rdf:type         sales:Delivery .

sales:MAT100        rdf:type         sales:Material ;
                    sales:availabilityStatus "OUT_OF_STOCK" .

sales:SUP300        rdf:type         sales:Supplier ;
                    rdfs:label       "Supplier 300" .

# Relationships between instances

sales:ACME          sales:places      sales:SO100 .
sales:SO100         sales:contains    sales:SO100_ITEM10 .
sales:SO100         sales:fulfilledBy sales:DEL800 .
sales:DEL800        sales:fulfills    sales:SO100_ITEM10 .
sales:SO100_ITEM10  sales:references  sales:MAT100 .
sales:MAT100        sales:suppliedBy  sales:SUP300 .

# SO101 — GLOBEX / CONFIRMED / MAT101 IN_STOCK / SUP301

sales:GLOBEX        rdf:type         sales:Customer ;
                    rdfs:label       "Globex Corp" .

sales:SO101         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 101" ;
                    sales:status     "CONFIRMED" .

sales:SO101_ITEM10  rdf:type         sales:SalesOrderItem .

sales:DEL801        rdf:type         sales:Delivery .

sales:MAT101        rdf:type         sales:Material ;
                    sales:availabilityStatus "IN_STOCK" .

sales:SUP301        rdf:type         sales:Supplier ;
                    rdfs:label       "Supplier 301" .

sales:GLOBEX        sales:places      sales:SO101 .
sales:SO101         sales:contains    sales:SO101_ITEM10 .
sales:SO101         sales:fulfilledBy sales:DEL801 .
sales:DEL801        sales:fulfills    sales:SO101_ITEM10 .
sales:SO101_ITEM10  sales:references  sales:MAT101 .
sales:MAT101        sales:suppliedBy  sales:SUP301 .

# SO102 — ACME / PENDING / MAT102 LOW_STOCK / SUP300 (same supplier as MAT100)

sales:SO102         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 102" ;
                    sales:status     "PENDING" .

sales:SO102_ITEM10  rdf:type         sales:SalesOrderItem .

sales:DEL802        rdf:type         sales:Delivery .

sales:MAT102        rdf:type         sales:Material ;
                    sales:availabilityStatus "LOW_STOCK" .

sales:ACME          sales:places      sales:SO102 .
sales:SO102         sales:contains    sales:SO102_ITEM10 .
sales:SO102         sales:fulfilledBy sales:DEL802 .
sales:DEL802        sales:fulfills    sales:SO102_ITEM10 .
sales:SO102_ITEM10  sales:references  sales:MAT102 .
sales:MAT102        sales:suppliedBy  sales:SUP300 .

# ─────────────────────────────────────────────
# Additional instance data — 5 more orders
# Introduces multi-item orders and shared materials/suppliers
# ─────────────────────────────────────────────

# New customer

sales:INITECH       rdf:type         sales:Customer ;
                    rdfs:label       "Initech Corp" .

# New supplier

sales:SUP302        rdf:type         sales:Supplier ;
                    rdfs:label       "Supplier 302" .

# New materials

sales:MAT103        rdf:type                 sales:Material ;
                    sales:availabilityStatus "IN_STOCK" .

sales:MAT104        rdf:type                 sales:Material ;
                    sales:availabilityStatus "OUT_OF_STOCK" .

sales:MAT105        rdf:type                 sales:Material ;
                    sales:availabilityStatus "OUT_OF_STOCK" .

sales:MAT103        sales:suppliedBy  sales:SUP300 .
sales:MAT104        sales:suppliedBy  sales:SUP302 .
sales:MAT105        sales:suppliedBy  sales:SUP302 .

# SO103 — ACME / CONFIRMED / 2 items: MAT101 (shared) + MAT103

sales:SO103         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 103" ;
                    sales:status     "CONFIRMED" .

sales:SO103_ITEM10  rdf:type         sales:SalesOrderItem .
sales:SO103_ITEM20  rdf:type         sales:SalesOrderItem .
sales:DEL803        rdf:type         sales:Delivery .

sales:ACME          sales:places      sales:SO103 .
sales:SO103         sales:contains    sales:SO103_ITEM10 .
sales:SO103         sales:contains    sales:SO103_ITEM20 .
sales:SO103         sales:fulfilledBy sales:DEL803 .
sales:DEL803        sales:fulfills    sales:SO103_ITEM10 .
sales:DEL803        sales:fulfills    sales:SO103_ITEM20 .
sales:SO103_ITEM10  sales:references  sales:MAT101 .
sales:SO103_ITEM20  sales:references  sales:MAT103 .

# SO104 — GLOBEX / DELAYED / 2 items: MAT100 (shared, out of stock) + MAT104

sales:SO104         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 104" ;
                    sales:status     "DELAYED" .

sales:SO104_ITEM10  rdf:type         sales:SalesOrderItem .
sales:SO104_ITEM20  rdf:type         sales:SalesOrderItem .
sales:DEL804        rdf:type         sales:Delivery .

sales:GLOBEX        sales:places      sales:SO104 .
sales:SO104         sales:contains    sales:SO104_ITEM10 .
sales:SO104         sales:contains    sales:SO104_ITEM20 .
sales:SO104         sales:fulfilledBy sales:DEL804 .
sales:DEL804        sales:fulfills    sales:SO104_ITEM10 .
sales:DEL804        sales:fulfills    sales:SO104_ITEM20 .
sales:SO104_ITEM10  sales:references  sales:MAT100 .
sales:SO104_ITEM20  sales:references  sales:MAT104 .

# SO105 — INITECH / PENDING / 1 item: MAT102 (shared, low stock)

sales:SO105         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 105" ;
                    sales:status     "PENDING" .

sales:SO105_ITEM10  rdf:type         sales:SalesOrderItem .
sales:DEL805        rdf:type         sales:Delivery .

sales:INITECH       sales:places      sales:SO105 .
sales:SO105         sales:contains    sales:SO105_ITEM10 .
sales:SO105         sales:fulfilledBy sales:DEL805 .
sales:DEL805        sales:fulfills    sales:SO105_ITEM10 .
sales:SO105_ITEM10  sales:references  sales:MAT102 .

# SO106 — INITECH / DELAYED / 2 items: MAT103 (shared) + MAT105

sales:SO106         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 106" ;
                    sales:status     "DELAYED" .

sales:SO106_ITEM10  rdf:type         sales:SalesOrderItem .
sales:SO106_ITEM20  rdf:type         sales:SalesOrderItem .
sales:DEL806        rdf:type         sales:Delivery .

sales:INITECH       sales:places      sales:SO106 .
sales:SO106         sales:contains    sales:SO106_ITEM10 .
sales:SO106         sales:contains    sales:SO106_ITEM20 .
sales:SO106         sales:fulfilledBy sales:DEL806 .
sales:DEL806        sales:fulfills    sales:SO106_ITEM10 .
sales:DEL806        sales:fulfills    sales:SO106_ITEM20 .
sales:SO106_ITEM10  sales:references  sales:MAT103 .
sales:SO106_ITEM20  sales:references  sales:MAT105 .

# SO107 — ACME / CONFIRMED / 2 items: MAT101 (shared) + MAT105 (shared with SO106)

sales:SO107         rdf:type         sales:SalesOrder ;
                    rdfs:label       "Sales Order 107" ;
                    sales:status     "CONFIRMED" .

sales:SO107_ITEM10  rdf:type         sales:SalesOrderItem .
sales:SO107_ITEM20  rdf:type         sales:SalesOrderItem .
sales:DEL807        rdf:type         sales:Delivery .

sales:ACME          sales:places      sales:SO107 .
sales:SO107         sales:contains    sales:SO107_ITEM10 .
sales:SO107         sales:contains    sales:SO107_ITEM20 .
sales:SO107         sales:fulfilledBy sales:DEL807 .
sales:DEL807        sales:fulfills    sales:SO107_ITEM10 .
sales:DEL807        sales:fulfills    sales:SO107_ITEM20 .
sales:SO107_ITEM10  sales:references  sales:MAT101 .
sales:SO107_ITEM20  sales:references  sales:MAT105 .
